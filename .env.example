# ============================================
# ROOTED VOICES BACKEND — ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# ─── Server ───
PORT=5001
NODE_ENV=production

# ─── Database ───
# Use a strong, unique password and a dedicated database user
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# ─── JWT Authentication ───
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_64_CHAR_RANDOM_STRING
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=CHANGE_ME_TO_A_DIFFERENT_64_CHAR_RANDOM_STRING
JWT_REFRESH_EXPIRE=30d

# ─── File Upload ───
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# ─── Email (SendGrid) ───
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx

# ─── Email (SMTP — fallback) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@rootedvoicestherapy.com
FROM_NAME=Rooted Voices

# ─── Evaluation Configuration ───
EVALUATION_FEE=195
THERAPIST_REVIEW_DAYS=3

# ─── Frontend URLs ───
FRONTEND_URL=https://your-frontend-domain.com
ADMIN_PANEL_URL=https://your-admin-domain.com

# ─── Rate Limiting ───
# Window in minutes, max requests per window
# Defaults: 15 min window, 100 requests — only override if needed
# RATE_LIMIT_WINDOW=15
# RATE_LIMIT_MAX_REQUESTS=100

# ─── Security ───
BCRYPT_ROUNDS=12

# ─── Stripe ───
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ─── Twilio SMS ───
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ─── Web Push (VAPID) ───
# Generate: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@rootedvoices.com

# ─── AI Services ───
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=

# ─── Video Conferencing ───
JITSI_SERVER_URL=https://meet.jit.si

# ─── OCR ───
USE_CLOUD_OCR=false

# ─── Session Reminders ───
ENABLE_SESSION_REMINDERS=true

# ─── Vercel Blob Storage ───
BLOB_READ_WRITE_TOKEN=
